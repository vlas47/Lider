[Unit]
Description=Gunicorn for AI_Lapin Django
After=network.target postgresql.service

[Service]
User=deploy
Group=www-data
WorkingDirectory=/srv/AI_Lapin
EnvironmentFile=/srv/AI_Lapin/.env
RuntimeDirectory=ai-lapin
RuntimeDirectoryMode=0755
ExecStart=/srv/AI_Lapin/venv/bin/gunicorn ai_lapin.wsgi:application --workers 1 --timeout 120 --bind unix:/run/ai-lapin/gunicorn.sock
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
