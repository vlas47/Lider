DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=ai.liderscan.ru,liderscan.ru,www.liderscan.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://ai.liderscan.ru,https://liderscan.ru,https://www.liderscan.ru
DJANGO_FORCE_SCRIPT_NAME=/ai-lapin
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DATABASE_URL=postgresql://ai_lapin:change-me@127.0.0.1:5432/ai_lapin
AI_LAPIN_PASSWORD=change-me
AI_LAPIN_DESKTOP_TOKEN=

# Optional external AI endpoint for Profi reply drafts.
AI_DRAFT_ENDPOINT=
AI_DRAFT_API_KEY=

# OpenAI API for Profi lead scoring and reply drafts.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# MAX Bot API notifications.
MAX_API_BASE=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_RECIPIENT_ID=
MAX_RECIPIENT_KIND=chat_id
MAX_CA_BUNDLE=/srv/AI_Lapin/certs/russiantrustedca.pem

# Server-side Profi browser/monitor.
PLAYWRIGHT_BROWSERS_PATH=/srv/AI_Lapin/.playwright-browsers
PROFI_DEFAULT_URL=https://profi.ru/backoffice/n.php
AI_LAPIN_PROFILES_ROOT=/srv/AI_Lapin/profiles
PROFI_BROWSER_PROFILE_DIR=/srv/AI_Lapin/profiles/profi/browser
PROFI_SEEN_ORDERS_PATH=/srv/AI_Lapin/profiles/profi/seen-orders.json
PROFI_MONITOR_MIN_SECONDS=60
PROFI_MONITOR_MAX_SECONDS=300
PROFI_MONITOR_SCORE_THRESHOLD=51

# Server-side Freelance.ru browser/monitor.
FREELANCE_DEFAULT_URL=https://freelance.ru/task?q=&c%5B%5D=4&a=1&v=1
FREELANCE_BROWSER_PROFILE_DIR=/srv/AI_Lapin/profiles/freelance/browser
FREELANCE_SEEN_ORDERS_PATH=/srv/AI_Lapin/profiles/freelance/seen-orders.json
FREELANCE_LOGIN=
FREELANCE_PASSWORD=
FREELANCE_MONITOR_MIN_SECONDS=60
FREELANCE_MONITOR_MAX_SECONDS=300
FREELANCE_MONITOR_SCORE_THRESHOLD=51
